<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)../../</RepositoryRoot>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.2.0</Version>
    <PackageId>Fizzy.McapSharp</PackageId>
    <Authors>Fizzy</Authors>
    <Description>File-based .NET bindings to the official Rust MCAP implementation.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);1591</WarningsAsErrors>
    <WarningsAsErrors Condition="'$(DocumentationStrict)' == 'true'">$(WarningsAsErrors);1570;1572;1573;1574;1580;1581;1584;1658</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(RepositoryRoot)README.md" Pack="true" PackagePath="/" />
    <None Include="$(RepositoryRoot)assets/icon.png" Pack="true" PackagePath="/" />
    <None Include="$(RepositoryRoot)assets/MCAP-LICENSE.txt" Pack="true" PackagePath="/" />
    <None Include="$(RepositoryRoot)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Fizzy.McapSharp.Tests" />
    <NativeAsset Include="$(RepositoryRoot)artifacts/native/win-x64/fizzy_mcap_native.dll" Rid="win-x64" PackagePath="runtimes/win-x64/native" />
    <NativeAsset Include="$(RepositoryRoot)artifacts/native/linux-x64/libfizzy_mcap_native.so" Rid="linux-x64" PackagePath="runtimes/linux-x64/native" />
    <NativeAsset Include="$(RepositoryRoot)artifacts/native/linux-arm64/libfizzy_mcap_native.so" Rid="linux-arm64" PackagePath="runtimes/linux-arm64/native" />
    <None Include="@(NativeAsset)" Pack="true" />
  </ItemGroup>
  <PropertyGroup>
    <NativeRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</NativeRuntimeIdentifier>
    <NativeRuntimeIdentifier Condition="'$(NativeRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</NativeRuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <None Update="@(NativeAsset->WithMetadataValue('Rid', '$(NativeRuntimeIdentifier)'))"
          Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireNativeForPackage" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('%(NativeAsset.Identity)')" Text="Missing %(NativeAsset.Rid) native asset. Collect all three assets from the same commit before packing." />
    <Exec Command="python &quot;$(RepositoryRoot)scripts/build.py&quot; verify-assets" />
  </Target>
</Project>
