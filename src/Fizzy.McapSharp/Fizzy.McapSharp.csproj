<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <PackageId>Fizzy.McapSharp</PackageId>
    <Authors>Fizzy</Authors>
    <Description>File-based .NET bindings to the official Rust MCAP implementation.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../native/target/release/fizzy_mcap_native.dll" Link="fizzy_mcap_native.dll" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes/win-x64/native" Condition="Exists('../../native/target/release/fizzy_mcap_native.dll')" />
  </ItemGroup>
  <Target Name="RequireNativeForPackage" BeforeTargets="GenerateNuspec" Condition="!Exists('../../native/target/release/fizzy_mcap_native.dll')">
    <Error Text="Build the win-x64 native library with scripts/Build.ps1 before packing." />
  </Target>
</Project>
